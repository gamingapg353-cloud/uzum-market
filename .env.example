# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env GitHub'ga yuklanmaydi (.gitignore da) — maxfiy kalitlarni faqat o'sha yerda saqlang.

# Sayt egasi (owner) — birinchi ishga tushirishda shu akkaunt yaratiladi
OWNER_EMAIL=
OWNER_PASSWORD=

# GitHub orqali kirish: https://github.com/settings/developers -> OAuth Apps
# Callback: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google orqali kirish: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email yuborish (Gmail): https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=
